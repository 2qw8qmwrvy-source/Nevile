{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": ["CI", "E2E_DATABASE_URL", "PLAYWRIGHT_CHROMIUM_EXECUTABLE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*"],
      "passThroughEnv": ["DATABASE_URL", "BETTER_AUTH_*", "NEVILE_*", "SENTRY_DSN", "APP_VERSION"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_*",
        "NEXT_PUBLIC_*",
        "NEVILE_*",
        "SENTRY_DSN",
        "APP_VERSION",
        "PORT"
      ]
    }
  }
}
