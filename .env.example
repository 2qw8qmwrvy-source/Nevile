# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL. DATABASE_URL is used by the web app, migrations and seeds; tests use
# TEST_DATABASE_URL (its name must end in _test; packages may create sibling
# databases such as nevile_api_test next to it).
DATABASE_URL=postgresql://nevile:nevile@localhost:5432/nevile_dev
TEST_DATABASE_URL=postgresql://nevile:nevile@localhost:5432/nevile_test

# Better Auth (@nevile/auth)
# Secret for signing sessions and email links. Required in production; generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the web app that serves /api/auth. Required in production.
BETTER_AUTH_URL=http://localhost:3000
# Optional, comma-separated: extra origins allowed to call /api/auth (the web origin and
# the nevile:// app scheme are always trusted).
BETTER_AUTH_TRUSTED_ORIGINS=
# Where auth rate limiting reads the client IP. Production needs one of:
# - BETTER_AUTH_TRUSTED_PROXIES: comma-separated IPs/CIDRs of every reverse proxy in front
#   of the app; the client is the rightmost X-Forwarded-For hop that is not one of them;
# - BETTER_AUTH_CLIENT_IP_HEADER: a single-value header your edge always overwrites
#   (e.g. cf-connecting-ip, x-vercel-forwarded-for, fly-client-ip).
# Only that one header is read. Leave both empty in local development.
BETTER_AUTH_TRUSTED_PROXIES=
BETTER_AUTH_CLIENT_IP_HEADER=

# Development only: when set (and NODE_ENV is not production), every auth email and SMS
# code printed to the console is also written as a JSON file
# ({kind, to, subject, text, links[], code?, sentAt}) into this directory, for browser
# tests to read. Never set it in staging or production; it is ignored there.
NEVILE_DEV_OUTBOX_DIR=

# Nevile Neighbours community program (SPEC §15): "true" or "false" (default false). Keep
# it off until the owner has decided who legally holds donated money. While off, program
# pages say "launching soon", donations are hidden and referrals are refused.
NEVILE_NEIGHBOURS_ENABLED=false

# Business photos and logos (SPEC §18).
# MEDIA_STORAGE: "local" (default in development) keeps files in MEDIA_LOCAL_DIR (default
# apps/web/.media when running the site) and serves them through /api/media. "s3" (required in production) uses
# any S3-compatible bucket, e.g. Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
# MEDIA_PUBLIC_BASE_URL: the bucket's public URL (custom domain), without a trailing
# slash. Leave it empty to serve media through the web app instead.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

# Bookings and payments (SPEC §19).
# PAYMENTS_PROVIDER: "fake" (default outside production) takes no real money: checkout and
# payout setup open test pages on this site (/dev/fake-checkout, /dev/fake-onboarding).
# "stripe" (required in production) uses Stripe Checkout and Stripe Connect Express. Use
# test-mode keys (sk_test_…) until launch; production refuses a test key unless
# NEVILE_ALLOW_TEST_PAYMENTS=true (staging only). Webhook endpoint:
#   https://<site>/api/webhooks/stripe  (events: checkout.session.completed,
#   checkout.session.expired, account.updated; Connect events can share the endpoint or
#   use their own secret in STRIPE_CONNECT_WEBHOOK_SECRET). See docs/OPERATIONS.md.
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
NEVILE_ALLOW_TEST_PAYMENTS=

# Scheduled jobs: call GET /api/cron every 5 minutes with "Authorization: Bearer $CRON_SECRET"
# (expires holds and requests, auto-confirms jobs, escalates problems, payout setup rule,
# Monday payouts). Required in production; generate with: openssl rand -base64 32
CRON_SECRET=
# Where problems unresolved after 3 days are escalated to Nevile staff (optional).
NEVILE_OPS_EMAIL=

# Web (apps/web): public site URL for metadata and server-side API calls.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Error reporting (Sentry) is off until a DSN is set; leave both empty in development and
# CI. SENTRY_DSN reports server errors; NEXT_PUBLIC_SENTRY_DSN reports browser errors and
# is built into the site (rebuild after changing it).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional version label of this deployment (e.g. a git commit SHA or release tag), used to
# tag error reports. Usually set by the deploy pipeline.
APP_VERSION=

# Mobile (apps/mobile) does not read this file: Expo loads apps/mobile/.env.local.
# Put EXPO_PUBLIC_API_URL there (the web app's origin, e.g. http://localhost:3000).
